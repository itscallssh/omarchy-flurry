#!/bin/bash
# flurry: drive the Flurry plugin from a terminal or a Hyprland bind.
#   flurry [toggle|on|off|next|effect <name>|intensity <0.25-2>|decorate|santa|yeti|plow [on|off|toggle]|lights|snowballs|
#           shake|fireworks [seconds]|season <auto|winter|spring>|surprise [bird|rabbit|golden]|diag|freeze|
#           wallpaper [on|off|toggle|status|fade <seconds>]|weather [on|off|now|status]|city <name>|location <lat> <lon>|calm <off|on|work>|sound [on|off|test|status]|
#           ornaments [style|next]|throwto <friend>|
#           gusts|writing|daycycle|seasons|newyear|surprises|theme|throwing|
#           code|name <name>|add <friend-code>|note <friend> <text>|status|clear|update [--yes]]
set -euo pipefail
call() { omarchy-shell flurry "$@"; }
cmd=${1:-toggle}; shift || true
case $cmd in
  toggle|on|off|next|decorate|santa|yeti|lights|snowballs|status|clear|shake|diag|freeze) call "$cmd" ;;
  plow) call plow "${1:-}" ;;
  wallpaper) call wallpaper "${1:-status}" "${2:-}" ;;
  effect) call effect "${1:?snow|leaves|starfall|rain|sakura|fireflies}" ;;
  intensity) call intensity "${1:?0.25 to 2}" ;;
  fireworks) call fireworks "${1:-60}" ;;
  season) call season "${1:?auto|winter|spring}" ;;
  surprise) call surprise "${1:-}" ;;   # cat is accepted as the old name of rabbit
  weather) call weather "${1:-status}" ;;
  city) call city "${*:?city name}" ;;
  location) call location "${1:?latitude}" "${2:?longitude}" ;;
  calm) call calm "${1:?off|on|work}" ;;
  sound) call sound "${1:-status}" ;;
  ornaments) call ornaments "${1:-next}" ;;
  throwto) call throwTo "${1:?friend}" ;;
  gusts) call toggleFlag windGusts ;;
  writing) call toggleFlag writing ;;
  daycycle) call toggleFlag dayCycle ;;
  seasons) call toggleFlag seasons ;;
  newyear) call toggleFlag newYear ;;
  surprises) call toggleFlag surprises ;;
  theme) call toggleFlag themeSync ;;
  throwing) call toggleFlag throwToFriends ;;
  code) call friendCode ;;
  name) call setName "${*:?name}" ;;
  add)
    code=${1:-}
    if [[ -z $code ]]; then
      code=$(wl-paste --no-newline 2>/dev/null) || { echo "flurry: clipboard is empty or has no text" >&2; exit 1; }
    fi
    call addFriend "$code" ;;
  note) target=${1:?friend}; shift; call note "$target" "${*:?text}" ;;
  update)
    # The plugin folder this script lives in (bin/..), updated from git.
    dir=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
    id=""
    if [[ -f "$dir/manifest.json" ]]; then
      if command -v jq >/dev/null 2>&1; then
        id=$(jq -r '.id // empty' "$dir/manifest.json" 2>/dev/null || true)
      else
        # No jq: the folder's name is not the plugin id (a clone is called
        # omarchy-flurry), so read "id" out of the manifest by hand.
        id=$(sed -n 's/^[[:space:]]*"id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$dir/manifest.json" | head -n 1)
      fi
    fi
    exec omarchy plugin update "${id:-$(basename "$dir")}" "$@" ;;
  -h|--help|help) sed -n 2,8p "$0" ;;
  *) echo "flurry: unknown command '$cmd'" >&2; exit 1 ;;
esac
